---
// Insignia circular de módulo (diseño propio): medalla con anillo, cinta y número.
interface Props {
  n: number;
  size?: number;
}
const { n, size = 44 } = Astro.props;
---

<svg class="badge" width={size} height={size} viewBox="0 0 48 48" aria-hidden="true">
  <path class="ribbon" d="M16 30 12 45l6-3 4 5 3-14M32 30l4 15-6-3-4 5-3-14" />
  <circle class="outer" cx="24" cy="20" r="16" />
  <circle class="inner" cx="24" cy="20" r="11.5" />
  <path class="ticks" d="M24 2.8v2.4M24 34.8v2.4M6.8 20h2.4M38.8 20h2.4" />
  <text x="24" y="20" dy="0.36em" text-anchor="middle">{n}</text>
</svg>

<style>
  .badge { flex: none; overflow: visible; transition: filter 0.15s; }
  .ribbon { fill: var(--color-accent-2-bg); stroke: var(--color-accent-2); stroke-width: 1.5; stroke-linejoin: round; }
  .outer { fill: var(--color-accent-bg); stroke: var(--color-accent); stroke-width: 1.75; }
  .inner { fill: var(--color-surface); stroke: var(--color-accent-2); stroke-width: 1.5; stroke-dasharray: 2 2.2; }
  .ticks { stroke: var(--color-accent); stroke-width: 1.75; stroke-linecap: round; }
  text { fill: var(--color-accent); font-family: var(--font-mono); font-weight: 700; font-size: 12px; }
</style>
