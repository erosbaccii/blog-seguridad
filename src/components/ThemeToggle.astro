---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);
---

<button class="theme" type="button" aria-pressed="false" aria-label={t.theme.toggle} data-theme-toggle>
  <svg class="moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
  </svg>
  <svg class="sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const current = () => root.dataset.theme ?? (media.matches ? 'dark' : 'light');

  function sync() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      b.setAttribute('aria-pressed', String(current() === 'dark'));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
    b.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('tema', next);
      } catch {
        /* sin almacenamiento: el cambio dura solo esta visita */
      }
      sync();
    });
  });
  media.addEventListener('change', sync);
  sync();
</script>

<style>
  .theme {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }
  .theme:hover { border-color: var(--color-accent); color: var(--color-accent); }
  /* Muestra la luna en modo claro (pasar a oscuro) y el sol en modo oscuro */
  .sun { display: none; }
  .theme[aria-pressed='true'] .sun { display: block; }
  .theme[aria-pressed='true'] .moon { display: none; }
</style>
