---
import Icon from '../Icon.astro';

interface Props {
  label: string;
  items: { label: string; href?: string }[];
}
const { label, items } = Astro.props;
---

<nav class="crumbs" aria-label={label}>
  <ol>
    {
      items.map((i, n) => (
        <li>
          {n > 0 && <Icon name="chevron" size={12} class="sep" />}
          {i.href ? <a href={i.href}>{i.label}</a> : <span aria-current="page">{i.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs { padding-top: 1.5rem; font-size: 0.85rem; }
  ol { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 0.15rem 0.35rem; margin: 0; padding: 0; }
  li { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--color-text-muted); }
  li :global(.sep) { color: var(--color-text-muted); }
  a { color: var(--color-accent); }
</style>
