---
/*
 * Ilustración isométrica propia: placa de circuito con un chip y un escudo con candado.
 * Las coordenadas salen de una proyección isométrica (u, v, altura) calculada acá,
 * así el SVG resultante es chico y fácil de ajustar. Colores: solo variables de la paleta.
 */
const S = 28; // tamaño de una celda de la grilla
const O = { x: 300, y: 255 }; // centro de la placa
const r = (n: number) => Math.round(n * 10) / 10;
const P = (u: number, v: number, h = 0) => [r(O.x + (u - v) * 0.866 * S), r(O.y + (u + v) * 0.5 * S - h)] as const;
const pt = (u: number, v: number, h = 0) => P(u, v, h).join(',');
const poly = (pts: [number, number, number][]) => pts.map(([u, v, h]) => pt(u, v, h)).join(' ');

/** Caja isométrica: cara superior y las dos caras visibles. */
const box = (u0: number, v0: number, u1: number, v1: number, h0: number, h1: number) => ({
  top: poly([[u0, v0, h1], [u1, v0, h1], [u1, v1, h1], [u0, v1, h1]]),
  right: poly([[u1, v0, h0], [u1, v1, h0], [u1, v1, h1], [u1, v0, h1]]),
  left: poly([[u0, v1, h0], [u1, v1, h0], [u1, v1, h1], [u0, v1, h1]]),
});

const board = box(-5, -5, 5, 5, -14, 0);
const chip = box(-1.7, -1.7, 1.7, 1.7, 0, 18);
const die = poly([[-1.05, -1.05, 18], [1.05, -1.05, 18], [1.05, 1.05, 18], [-1.05, 1.05, 18]]);

const grid: string[] = [];
for (let k = -4; k <= 4; k++) {
  grid.push(`M${pt(k, -5)}L${pt(k, 5)}`, `M${pt(-5, k)}L${pt(5, k)}`);
}

// Pistas del circuito (en la grilla u, v), desde el chip hacia los bordes
const pistas: [number, number][][] = [
  [[1.7, -0.8], [3, -0.8], [3, -2.5], [4.3, -2.5]],
  [[1.7, 0.6], [3.6, 0.6], [3.6, 1.9], [4.4, 1.9]],
  [[0.8, 1.7], [0.8, 3.2], [2.3, 3.2], [2.3, 4.3]],
  [[-0.6, 1.7], [-0.6, 4.3]],
  [[-1.7, 0.9], [-3.2, 0.9], [-3.2, 2.6], [-4.3, 2.6]],
  [[-1.7, -0.5], [-4.3, -0.5]],
  [[-0.9, -1.7], [-0.9, -3.3], [-2.6, -3.3], [-2.6, -4.3]],
  [[0.7, -1.7], [0.7, -4.3]],
];
const trazos = pistas.map((p) => 'M' + p.map(([u, v]) => pt(u, v)).join('L'));
const pads = pistas.map((p) => P(...(p.at(-1) as [number, number])));
const vias = ([[3, -2.5], [3.6, 0.6], [0.8, 3.2], [-3.2, 0.9], [-0.9, -3.3]] as [number, number][]).map(([u, v]) => P(u, v));

// Patitas del chip
const patas: string[] = [];
for (const k of [-1.2, -0.6, 0, 0.6, 1.2]) {
  patas.push(`M${pt(1.7, k, 3)}L${pt(2.05, k)}`, `M${pt(k, 1.7, 3)}L${pt(k, 2.05)}`);
  patas.push(`M${pt(-1.7, k, 3)}L${pt(-2.05, k)}`, `M${pt(k, -1.7, 3)}L${pt(k, -2.05)}`);
}

// Componentes pequeños (capacitores y resistencias), de atrás hacia adelante
const comps = [
  box(-4.2, -2.2, -3.5, -1.5, 0, 9),
  box(1.9, -4.3, 2.5, -3.4, 0, 7),
  box(3.9, -1.2, 4.5, -0.3, 0, 7),
  box(-2.4, 3.4, -1.6, 4.1, 0, 10),
  box(3.2, 3.1, 4.1, 3.8, 0, 6),
].map((b, i) => ({ ...b, i }));

const centro = P(0, 0, 18);
const anillo = (rad: number) => ({ rx: r(rad * S * 1.2247), ry: r(rad * S * 0.7071) });
const [cx, cy] = P(0, 0, 0);
const ring1 = anillo(2.7);
const ring2 = anillo(3.9);
const shield = { x: centro[0], y: centro[1] - 78 };

const brillos = [
  { x: 196, y: 128, s: 1, c: 'b1' },
  { x: 408, y: 112, s: 0.8, c: 'b2' },
  { x: 446, y: 178, s: 0.55, c: 'b1' },
  { x: 160, y: 205, s: 0.6, c: 'b2' },
  { x: 352, y: 86, s: 0.5, c: 'b3' },
];
---

<svg class="hero-art" viewBox="40 60 520 380" role="img" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="g-board" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" class="s-board-1" />
      <stop offset="1" class="s-board-2" />
    </linearGradient>
    <linearGradient id="g-shield" x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0" class="s-shield-1" />
      <stop offset="1" class="s-shield-2" />
    </linearGradient>
    <radialGradient id="g-glow">
      <stop offset="0" class="s-glow" stop-opacity="0.75" />
      <stop offset="1" class="s-glow" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="g-beam" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="s-glow" stop-opacity="0" />
      <stop offset="1" class="s-glow" stop-opacity="0.35" />
    </linearGradient>
    <filter id="f-blur" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="2.2" />
    </filter>
  </defs>

  <!-- Placa -->
  <polygon class="board-side-l" points={board.left} />
  <polygon class="board-side-r" points={board.right} />
  <polygon class="board-top" points={board.top} />
  <path class="grid" d={grid.join('')} />

  <!-- Anillos de luz alrededor del chip -->
  <ellipse class="ring ring-1" cx={cx} cy={cy} rx={ring1.rx} ry={ring1.ry} />
  <ellipse class="ring ring-2" cx={cx} cy={cy} rx={ring2.rx} ry={ring2.ry} />

  <!-- Pistas, pulsos de luz y pads -->
  <path class="traces" d={trazos.join('')} />
  <g class="pulses" filter="url(#f-blur)">
    {trazos.map((d, i) => <path class={`p${i}`} d={d} pathLength="100" />)}
  </g>
  {pads.map(([x, y]) => <ellipse class="pad" cx={x} cy={y} rx="6" ry="3.5" />)}
  {vias.map(([x, y]) => <ellipse class="via" cx={x} cy={y} rx="3.2" ry="1.9" />)}

  <!-- Componentes -->
  {
    comps.map((c) => (
      <g class={c.i % 2 ? 'comp comp-b' : 'comp'}>
        <polygon class="c-l" points={c.left} />
        <polygon class="c-r" points={c.right} />
        <polygon class="c-t" points={c.top} />
      </g>
    ))
  }

  <!-- Chip -->
  <path class="pins" d={patas.join('')} />
  <polygon class="chip-l" points={chip.left} />
  <polygon class="chip-r" points={chip.right} />
  <polygon class="chip-t" points={chip.top} />
  <polygon class="die" points={die} />

  <!-- Haz de luz y escudo -->
  <ellipse class="glow" cx={centro[0]} cy={centro[1]} rx="70" ry="40" fill="url(#g-glow)" />
  <polygon class="beam" points={`${centro[0] - 30},${shield.y + 10} ${centro[0] + 30},${shield.y + 10} ${centro[0] + 44},${centro[1]} ${centro[0] - 44},${centro[1]}`} fill="url(#g-beam)" />
  <g class="shield" transform={`translate(${shield.x} ${shield.y})`}>
    <path class="shield-back" d="M0-41 33-29V-2C33 22 16 35 0 41-16 35-33 22-33-2V-29z" />
    <path class="shield-front" d="M0-36 28-26V-2C28 18 14 29 0 35-14 29-28 18-28-2V-26z" fill="url(#g-shield)" />
    <path class="shield-shine" d="M-22-21 0-29V30C-12 24-22 14-22-2z" />
    <path class="lock-shackle" d="M-8-3v-6a8 8 0 0 1 16 0v6" />
    <rect class="lock-body" x="-12" y="-4" width="24" height="19" rx="3.5" />
    <circle class="lock-hole" cx="0" cy="4" r="2.6" />
    <path class="lock-hole-line" d="M0 6v4.5" />
  </g>

  <!-- Brillos -->
  {
    brillos.map((b, i) => (
      <path
        class={`spark ${b.c} s${i}`}
        transform={`translate(${b.x} ${b.y}) scale(${b.s})`}
        d="M0-10Q1-1 10 0Q1 1 0 10Q-1 1-10 0Q-1-1 0-10z"
      />
    ))
  }
</svg>

<style>
  .hero-art { width: 100%; height: auto; max-width: 560px; overflow: visible; }
  .s-board-1 { stop-color: color-mix(in srgb, var(--l-accent) 22%, var(--d-surface)); }
  .s-board-2 { stop-color: color-mix(in srgb, var(--violet) 14%, var(--d-bg)); }
  .s-shield-1 { stop-color: var(--d-accent); }
  .s-shield-2 { stop-color: var(--l-accent); }
  .s-glow { stop-color: var(--d-accent-2); }

  .board-top { fill: url(#g-board); stroke: color-mix(in srgb, var(--d-accent-2) 45%, transparent); stroke-width: 1; }
  .board-side-l { fill: color-mix(in srgb, var(--l-accent) 18%, var(--d-bg)); }
  .board-side-r { fill: color-mix(in srgb, var(--l-accent) 30%, var(--d-bg)); }
  .grid { stroke: color-mix(in srgb, var(--d-accent) 14%, transparent); stroke-width: 0.6; fill: none; }

  .ring { fill: none; stroke-width: 1; }
  .ring-1 { stroke: color-mix(in srgb, var(--d-accent-2) 55%, transparent); stroke-dasharray: 3 5; }
  .ring-2 { stroke: color-mix(in srgb, var(--violet) 45%, transparent); stroke-dasharray: 1 7; }

  .traces { fill: none; stroke: color-mix(in srgb, var(--d-accent) 70%, transparent); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .pulses path { fill: none; stroke: var(--d-accent-2); stroke-width: 3.2; stroke-linecap: round; stroke-dasharray: 7 93; stroke-dashoffset: 100; opacity: 0; }
  .pad { fill: var(--d-bg); stroke: var(--d-accent-2); stroke-width: 1.6; }
  .via { fill: color-mix(in srgb, var(--violet) 70%, var(--d-bg)); }

  .comp .c-t { fill: color-mix(in srgb, var(--d-border) 70%, var(--d-accent)); }
  .comp .c-l { fill: var(--d-surface); }
  .comp .c-r { fill: var(--d-border); }
  .comp-b .c-t { fill: color-mix(in srgb, var(--violet) 55%, var(--d-surface)); }

  .pins { stroke: var(--d-text-muted); stroke-width: 1.6; stroke-linecap: round; }
  .chip-t { fill: color-mix(in srgb, var(--d-surface) 80%, var(--l-accent)); stroke: color-mix(in srgb, var(--d-accent-2) 60%, transparent); stroke-width: 1; }
  .chip-l { fill: var(--d-bg); }
  .chip-r { fill: color-mix(in srgb, var(--d-bg) 70%, var(--d-surface)); }
  .die { fill: none; stroke: var(--d-accent-2); stroke-width: 1.2; stroke-dasharray: 4 3; opacity: 0.8; }

  .beam { mix-blend-mode: screen; }
  .shield-back { fill: color-mix(in srgb, var(--d-accent-2) 22%, transparent); stroke: var(--d-accent-2); stroke-width: 1.5; }
  .shield-front { stroke: color-mix(in srgb, var(--d-text) 55%, transparent); stroke-width: 1; }
  .shield-shine { fill: var(--d-text); opacity: 0.12; }
  .lock-shackle { fill: none; stroke: var(--d-text); stroke-width: 3; stroke-linecap: round; }
  .lock-body { fill: var(--d-text); }
  .lock-hole { fill: var(--l-accent); }
  .lock-hole-line { stroke: var(--l-accent); stroke-width: 2.4; stroke-linecap: round; }

  .spark { transform-box: fill-box; transform-origin: center; }
  .b1 { fill: var(--d-accent-2); }
  .b2 { fill: var(--violet); }
  .b3 { fill: var(--d-text); }

  /* Animación sutil: pulsos de luz que recorren las pistas y el escudo que flota */
  @media (prefers-reduced-motion: no-preference) {
    .pulses path { animation: pulso 4.4s linear infinite; }
    .shield { animation: flotar 6s ease-in-out infinite; }
    .spark { animation: titilar 3.6s ease-in-out infinite; }
  }
  /* Desfase de cada pulso y cada brillo (en clases, no en style="": lo exige la CSP) */
  .pulses .p1 { animation-delay: 0.55s; } .pulses .p2 { animation-delay: 1.1s; } .pulses .p3 { animation-delay: 1.65s; }
  .pulses .p4 { animation-delay: 2.2s; } .pulses .p5 { animation-delay: 2.75s; } .pulses .p6 { animation-delay: 3.3s; }
  .pulses .p7 { animation-delay: 3.85s; }
  .s1 { animation-delay: 0.7s; } .s2 { animation-delay: 1.4s; } .s3 { animation-delay: 2.1s; } .s4 { animation-delay: 2.8s; }
  @keyframes pulso {
    0% { stroke-dashoffset: 100; opacity: 0; }
    8% { opacity: 1; }
    70% { opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes flotar {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -5px; }
  }
  @keyframes titilar {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
</style>
