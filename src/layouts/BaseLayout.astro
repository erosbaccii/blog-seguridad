---
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, otherLang, localizedFile, type Lang } from '../i18n';
import { SITE } from '../config/site';

export interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** URL de esta misma página en el otro idioma (para el selector). */
  translationUrl: string;
  /** false si la página del otro idioma es solo un aviso (no se anuncia en hreflang). */
  hasTranslation?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Imagen para compartir (1200×630). Si no se pasa, se usa la imagen por defecto del idioma. */
  ogImage?: { src: string; alt: string; width: number; height: number };
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** Datos estructurados (schema.org). Es un bloque de datos: la CSP no lo trata como script. */
  jsonLd?: Record<string, unknown>;
}

const {
  lang,
  title,
  description,
  translationUrl,
  hasTranslation = true,
  noindex = false,
  ogType = 'website',
  ogImage,
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd,
} = Astro.props;

const t = useTranslations(lang);
const other = otherLang(lang);
const desc = description ?? t.meta.siteDescription;
const fullTitle = title === t.meta.siteName ? title : `${title} · ${t.meta.siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const altUrl = new URL(translationUrl, Astro.site);
const esUrl = lang === 'es' ? canonical : altUrl;
const img = ogImage ?? { src: `/og/default-${lang}.png`, alt: t.meta.ogImageAlt, width: 1200, height: 630 };
const imgUrl = new URL(img.src, Astro.site);
const rss = (l: Lang) => localizedFile(l, 'rss.xml');
---

<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- Aplica el tema guardado antes de pintar (archivo externo: compatible con la CSP) -->
    <script is:inline src="/tema.js"></script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical} />
          {hasTranslation && <link rel="alternate" hreflang={other} href={altUrl} />}
          <link rel="alternate" hreflang="x-default" href={hasTranslation || lang === 'es' ? esUrl : canonical} />
        </>
      )
    }
    <link rel="alternate" type="application/rss+xml" title={`${t.meta.siteName} — RSS`} href={rss(lang)} hreflang={lang} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (LinkedIn, WhatsApp, etc.) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {hasTranslation && <meta property="og:locale:alternate" content={useTranslations(other).meta.ogLocale} />}
    <meta property="og:image" content={imgUrl} />
    <meta property="og:image:width" content={String(img.width)} />
    <meta property="og:image:height" content={String(img.height)} />
    <meta property="og:image:alt" content={img.alt} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {ogType === 'article' && <meta property="article:author" content={SITE.linkedin} />}
    {ogType === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={imgUrl} />
    <meta name="twitter:image:alt" content={img.alt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t.a11y.skipToContent}</a>
    <Header lang={lang} translationUrl={translationUrl} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
  .skip-link:focus { top: 1rem; }
  main:focus { outline: none; }
</style>
