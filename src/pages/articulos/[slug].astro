---
import ArticlePage from '../../views/ArticlePage.astro';
import { getRutasArticulos } from '../../lib/articulos';

export async function getStaticPaths() {
  return getRutasArticulos('es');
}

const { slug, entry, alternate } = Astro.props;
---

<ArticlePage lang="es" slug={slug} entry={entry} alternate={alternate} />
