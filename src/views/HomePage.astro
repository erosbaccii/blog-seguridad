---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Icon from '../components/Icon.astro';
import ModuleBadge from '../components/ModuleBadge.astro';
import HeroIllustration from '../components/home/HeroIllustration.astro';
import { useTranslations, localizedPath, otherLang, fmt, type Lang } from '../i18n';
import { getArticulos } from '../lib/articulos';
import { getModulos } from '../lib/navegacion';
import { SITE } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const articlesUrl = localizedPath(lang, 'articles');
const trainingUrl = localizedPath(lang, 'training');
const aboutUrl = localizedPath(lang, 'about');
const ultimos = (await getArticulos(lang)).slice(0, 6);
const modulos = await getModulos(lang);
const byCat = (c: string) => `${articlesUrl}?categoria=${c}`;

// Ítems de las tarjetas, generados desde las categorías y módulos existentes
const aprender = [
  { icon: 'blue-team', label: t.categories['blue-team'], href: byCat('blue-team') },
  { icon: 'anti-phishing', label: t.home.antiPhishing, href: trainingUrl },
  { icon: 'ia-seguridad', label: t.categories['ia-seguridad'], href: byCat('ia-seguridad') },
];
const entrenamiento = modulos.map((m) => ({
  n: m.data.order,
  label: m.data.title,
  sub: fmt(t.training.moduleLabel, { n: m.data.order }),
  href: localizedPath(lang, 'training', m.id.split('/')[0]),
}));
const adicionales = [
  ...(['que-hacer-si', 'casos-reales', 'tesis'] as const).map((c) => ({
    label: t.categories[c],
    text: t.categoryDescriptions[c],
    href: byCat(c),
  })),
  { label: t.about.contactTitle, text: t.about.contactDescription, href: `${aboutUrl}#contacto` },
];

// Datos estructurados del sitio y del autor (solo datos reales: nombre y perfiles)
const home = new URL(localizedPath(lang, 'home'), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${home}#sitio`, url: home, name: t.meta.siteName, description: t.meta.siteDescription, inLanguage: t.meta.dateLocale },
    { '@type': 'Person', '@id': `${home}#autor`, name: SITE.author, url: new URL(aboutUrl, Astro.site).href, sameAs: [SITE.linkedin, SITE.github] },
  ],
};
---

<BaseLayout lang={lang} title={t.meta.siteName} translationUrl={localizedPath(otherLang(lang), 'home')} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <h1>{SITE.shortName}</h1>
        <p class="subtitle">{t.home.subtitle}</p>
        <div class="ctas">
          <a class="hbtn hbtn-primary" href={articlesUrl}>{t.home.ctaArticles}</a>
          <a class="hbtn hbtn-ghost" href={`${aboutUrl}#contacto`}>{t.home.ctaContact}</a>
        </div>
      </div>
      <div class="hero-art-wrap">
        <HeroIllustration />
      </div>
    </div>
  </section>

  <section class="container section resources" aria-labelledby="recursos">
    <h2 id="recursos" class="center-title">{t.home.resourcesTitle}</h2>
    <div class="cards">
      <article class="rcard">
        <h3>{t.home.learn.title}</h3>
        <p class="rdesc">{t.home.learn.description}</p>
        <ul role="list" class="ritems">
          {
            aprender.map((i) => (
              <li>
                <a class="ritem" href={i.href}>
                  <span class="ricon"><Icon name={i.icon} size={26} /></span>
                  <span class="rlabel">{i.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="rfoot" href={articlesUrl}>{t.home.learn.footer} <Icon name="chevron" size={16} /></a>
      </article>

      <article class="rcard">
        <h3>{t.home.train.title}</h3>
        <p class="rdesc">{t.home.train.description}</p>
        <ul role="list" class="ritems">
          {
            entrenamiento.length === 0 ? (
              <li class="ritem ritem-static">
                <span class="rbadge"><ModuleBadge n={1} size={44} /></span>
                <span class="rmuted">{t.home.train.empty}</span>
              </li>
            ) : (
              entrenamiento.map((m) => (
                <li>
                  <a class="ritem" href={m.href}>
                    <span class="rbadge"><ModuleBadge n={m.n} size={44} /></span>
                    <span>
                      <span class="rlabel">{m.label}</span>
                      <span class="rsub">{m.sub}</span>
                    </span>
                  </a>
                </li>
              ))
            )
          }
        </ul>
        <a class="rfoot" href={trainingUrl}>{t.home.train.footer} <Icon name="chevron" size={16} /></a>
      </article>

      <article class="rcard">
        <h3>{t.home.more.title}</h3>
        <p class="rdesc">{t.home.more.description}</p>
        <ul role="list" class="rlinks">
          {
            adicionales.map((i) => (
              <li>
                <a href={i.href}>{i.label}</a>
                <p>{i.text}</p>
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </section>

  <section class="container section" aria-labelledby="ultimos">
    <div class="section-head">
      <h2 id="ultimos">{t.home.latestTitle}</h2>
      {ultimos.length > 0 && <a href={articlesUrl}>{t.home.viewAll}</a>}
    </div>
    {
      ultimos.length === 0 ? (
        <p class="card">{t.home.latestEmpty}</p>
      ) : (
        <ul class="latest" role="list">
          {ultimos.map((a) => (
            <li><ArticleCard lang={lang} articulo={a} /></li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  /* ---------- Banner (oscuro azulado en los dos modos) ---------- */
  .hero {
    color: var(--hero-text);
    background:
      radial-gradient(60rem 30rem at 85% 40%, color-mix(in srgb, var(--d-accent-2) 16%, transparent), transparent 70%),
      radial-gradient(40rem 24rem at 0% 100%, color-mix(in srgb, var(--violet) 14%, transparent), transparent 70%),
      linear-gradient(135deg, var(--hero-bg) 0%, var(--hero-bg-2) 100%);
    border-bottom: 1px solid var(--hero-border);
    overflow: hidden;
  }
  .hero-inner {
    display: grid;
    align-items: center;
    gap: 1rem;
    padding-block: 2.5rem 1.5rem;
  }
  .hero h1 { color: var(--hero-text); font-size: clamp(2.2rem, 1.6rem + 3vw, 3.4rem); margin-bottom: 0.4rem; }
  .subtitle { font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem); color: var(--hero-text-muted); max-width: 32ch; margin-bottom: 1.6rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hbtn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.55rem 1.2rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    border: 1px solid transparent;
  }
  .hbtn:hover { text-decoration: none; }
  .hbtn:focus-visible { outline-color: var(--hero-accent); }
  .hbtn-primary { background: var(--hero-accent); color: var(--hero-on-accent); }
  .hbtn-primary:hover { background: color-mix(in srgb, var(--hero-accent) 85%, var(--hero-text)); }
  .hbtn-ghost { color: var(--hero-text); border-color: color-mix(in srgb, var(--hero-text) 40%, transparent); }
  .hbtn-ghost:hover { border-color: var(--hero-text); background: color-mix(in srgb, var(--hero-text) 8%, transparent); }
  .hero-art-wrap { display: flex; justify-content: center; margin-inline: -0.5rem; }
  @media (min-width: 56rem) {
    .hero-inner { grid-template-columns: 1fr 1.1fr; padding-block: 3.5rem; min-height: 26rem; }
  }

  /* ---------- Recursos y entrenamiento ---------- */
  .center-title { text-align: center; font-size: clamp(1.6rem, 1.3rem + 1.4vw, 2.2rem); margin-bottom: 1.75rem; }
  .cards { display: grid; gap: 1rem; }
  @media (min-width: 60rem) { .cards { grid-template-columns: repeat(3, 1fr); } }
  .rcard {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.6rem;
    background: var(--color-card-blue);
    border: 1px solid var(--color-border);
    border-radius: 14px;
  }
  .rcard h3 { font-size: 1.3rem; margin-bottom: 0.35rem; }
  .rdesc { color: var(--color-text-muted); margin-bottom: 1.25rem; }
  .ritems, .rlinks { list-style: none; margin: 0 0 1.25rem; padding: 0; display: grid; gap: 0.35rem; }
  .ritem {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.45rem 0.25rem;
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    font-weight: 600;
  }
  .ritem-static { color: var(--color-text); font-weight: 400; }
  .ricon {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: var(--color-accent-2-bg);
    color: var(--color-accent-2-text);
    border: 1px solid color-mix(in srgb, var(--color-accent-2) 35%, transparent);
    transition: box-shadow 0.15s, background-color 0.15s;
  }
  .rbadge { flex: none; display: inline-flex; transition: filter 0.15s; }
  .rsub { display: block; font-size: 0.82rem; font-weight: 400; color: var(--color-text-muted); }
  .rmuted { color: var(--color-text-muted); font-size: 0.95rem; }
  .ritem:hover { text-decoration: none; }
  .ritem:hover .rlabel { text-decoration: underline; text-underline-offset: 0.18em; }
  .ritem:hover .ricon {
    background: color-mix(in srgb, var(--color-accent-2) 24%, var(--color-surface));
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent-2) 18%, transparent), 0 0 18px color-mix(in srgb, var(--color-accent-2) 45%, transparent);
  }
  .ritem:hover .rbadge { filter: drop-shadow(0 0 6px color-mix(in srgb, var(--color-accent-2) 70%, transparent)); }
  .rlinks { gap: 0.9rem; }
  .rlinks a { font-weight: 600; }
  .rlinks p { margin: 0.1rem 0 0; font-size: 0.92rem; color: var(--color-text-muted); }
  .rfoot { margin-top: auto; display: inline-flex; align-items: center; gap: 0.25rem; font-weight: 600; }

  /* ---------- Últimos artículos ---------- */
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1rem; margin-bottom: 1.25rem; }
  .section-head h2 { margin: 0; }
  .latest { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 40rem) { .latest { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .latest { grid-template-columns: repeat(3, 1fr); } }
</style>
