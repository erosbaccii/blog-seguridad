---
import DocsLayout from '../layouts/DocsLayout.astro';
import Breadcrumb from '../components/docs/Breadcrumb.astro';
import ModuleBadge from '../components/ModuleBadge.astro';
import { useTranslations, localizedPath, otherLang, fmt, type Lang } from '../i18n';
import { navEntrenamiento, getModulos } from '../lib/navegacion';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const url = localizedPath(lang, 'training');
const groups = await navEntrenamiento(lang);
const modulos = await getModulos(lang);
---

<DocsLayout
  lang={lang}
  title={t.training.title}
  description={t.training.intro}
  translationUrl={localizedPath(otherLang(lang), 'training')}
  navLabel={t.docs.sectionNavTraining}
  groups={groups}
  emptyText={t.training.comingSoon}
  rootLink={{ label: t.training.title, href: url, current: true }}
>
  <Breadcrumb label={t.a11y.breadcrumb} items={[{ label: t.nav.home, href: localizedPath(lang, 'home') }, { label: t.nav.training }]} />
  <header class="head">
    <h1>{t.training.title}</h1>
    <p class="lead">{t.training.intro}</p>
  </header>

  <h2>{t.training.courseName}</h2>
  {
    modulos.length === 0 ? (
      <p class="card soon">
        <ModuleBadge n={1} size={44} />
        <span>{t.training.comingSoon}</span>
      </p>
    ) : (
      <ol class="modules" role="list">
        {modulos.map((m) => (
          <li class="card">
            <ModuleBadge n={m.data.order} size={44} />
            <div>
              <p class="eyebrow">{fmt(t.training.moduleLabel, { n: m.data.order })}</p>
              <a href={localizedPath(lang, 'training', m.id.split('/')[0])}>{m.data.title}</a>
              <p>{m.data.description}</p>
            </div>
          </li>
        ))}
      </ol>
    )
  }
</DocsLayout>

<style>
  .head { padding: 1.25rem 0 1.5rem; }
  .soon { display: flex; align-items: center; gap: 1rem; max-width: var(--maxw-prose); }
  .modules { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; max-width: var(--maxw-prose); }
  .modules li { display: flex; gap: 1rem; align-items: flex-start; }
  .modules p { margin: 0; }
</style>
